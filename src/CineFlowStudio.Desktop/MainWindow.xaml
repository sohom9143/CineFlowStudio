<Window x:Class="CineFlowStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CineFlow AI Studio — Enterprise Desktop Edition" 
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- 1. TOP NAVIGATION AND ZERO-COPY AUTO-HANDSHAKE BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="CineFlow-AI" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
                    <Border Background="#261E0A" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="ENTERPRISE" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Zero-Copy Auto Handshake Status Indicator -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#0F172A" CornerRadius="20" Padding="14,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding IsOnline, Converter={x:Null}, FallbackValue='#10B981'}" />
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" • " Foreground="{StaticResource TextSecondary}" Margin="6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GpuDevice}" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Auto-Sync Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding RefreshBridgeCommand}" 
                            ToolTip="Check Firebase Realtime Database for active Colab tunnel URL"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Auto-Sync Colab" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN 3-PANE WORKSPACE -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pane 1: Character Studio and Face Bank -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,16,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="👤 Character Face Bank" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Enrolled consistent identities" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,14" />
                    </StackPanel>

                    <!-- Character List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" 
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#1E293B" ClipToBounds="True">
                                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border Background="#132E22" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="95% Match" Foreground="{StaticResource AccentEmerald}" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding Gender}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <TextBlock Text="+ Enroll New Character" />
                    </Button>
                </Grid>
            </Border>

            <!-- Pane 2: Scene Director and Synthesis Controls -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,16,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🎥 Scene Director" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Configure camera motion and cinematic framing" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,16" />

                        <!-- Prompt Input -->
                        <TextBlock Text="SCENE PROMPT" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource CinemaTextBoxStyle}" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <!-- Resolution Switcher: 480p / 720p -->
                        <TextBlock Text="OUTPUT RESOLUTION" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding Select480pCommand}"
                                    Background="{Binding SelectedResolution, Converter={x:Null}, FallbackValue='#1E293B'}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="480p (Fast)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Low VRAM / Ultra Fast" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding Select720pCommand}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="720p (HD Cinema)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="High Detail / Master" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Aspect Ratio Switcher: 16:9 / 9:16 -->
                        <TextBlock Text="ASPECT RATIO" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding Select16x9Command}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="16:9 (Landscape)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="YouTube / Film Cinema" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding Select9x16Command}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="9:16 (Portrait)" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Shorts / Reels / TikTok" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Motion Scale Slider -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="CAMERA MOTION SCALE" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Text="{Binding MotionScale, StringFormat='{}{0:F1}'}" Foreground="{StaticResource AccentGold}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1.0" Maximum="10.0" Value="{Binding MotionScale}" SmallChange="0.5" LargeChange="1.0" Margin="0,0,0,24" />

                        <!-- Generate Master Shot Button -->
                        <Button Style="{StaticResource CinemaButtonStyle}" 
                                Command="{Binding GenerateShotCommand}"
                                Height="48">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Generate Cinema Master" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Generation Live Status -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,14,0,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <TextBlock Text="{Binding GenerationStatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Pane 3: Cinema Player and Streaming Screen -->
            <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📺 Cinema Master Screen" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="H.264 FastStart Hardware Player" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#1B263B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedResolution}" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Player Stage -->
                    <Border Grid.Row="1" Background="#000000" CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <Grid>
                            <!-- Standby Notice when no video is active -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="🎥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.4" />
                                <TextBlock Text="Cinema Screen Ready" Foreground="{StaticResource TextSecondary}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Select a character and click 'Generate Cinema Master'" Foreground="{StaticResource TextSecondary}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Media Player Element -->
                            <MediaElement x:Name="MasterVideoPlayer" 
                                          LoadedBehavior="Play" 
                                          UnloadedBehavior="Stop" 
                                          ScrubbingEnabled="True" 
                                          HorizontalAlignment="Stretch" 
                                          VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <!-- Player Footer Controls -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text="H.264 FastStart" Foreground="{StaticResource AccentEmerald}" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding PlaybackUrl}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" Margin="0,0,6,0" />
                                <TextBlock Text="Save Master MP4" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. STATUS FOOTER -->
        <Border Grid.Row="2" Background="#070A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="CineFlow-AI Studio v2.0 Enterprise • Wan 2.1 DiT + LivePortrait LipSync • Firebase Auto-Sync Active" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                <TextBlock Text="Google Colab T4 Cloud GPU Backend" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
